# Go Monitoring Agent Configuration

# Server Configuration
METRICS_PORT=8080         # Port for HTTP metrics server
WS_PORT=8081              # Port for WebSocket server (optional)

# Docker Integration
DOCKER_ENABLED=true       # Enable or disable Docker metrics collection
DOCKER_HOST=unix:///var/run/docker.sock  # Docker socket path (leave empty for default)

# Metrics Collection
COLLECTION_INTERVAL=10    # Seconds between metrics collection (default: 10)

# Logging
LOG_LEVEL=info            # Logging level: debug, info, warn, error
